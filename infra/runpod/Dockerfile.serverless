# RunPod Serverless Docker image with Llama 3.1-8B weights baked in.
#
# Baking the weights into the image (~15 GB total) eliminates the
# HuggingFace download step on cold start, reducing wake-up time from
# several minutes to ~20 seconds.
#
# Build:
#   docker build --secret id=hf_token,env=HF_TOKEN -t ghcr.io/org/autonomous-sre-vllm-serverless:latest .
#   docker push ghcr.io/org/autonomous-sre-vllm-serverless:latest
#
# Pre-requisite: accept Meta's license at https://huggingface.co/meta-llama/Llama-3.1-8B-Instruct
# with the same HuggingFace account that owns HF_TOKEN, otherwise you'll get a 401.
#
# Registry: push to a registry close to your RunPod region to minimise
# layer pull time on the first cold start.

FROM vllm/vllm-openai:latest AS base

# Install huggingface_hub CLI for weight download
RUN pip install --no-cache-dir huggingface_hub[cli]

# Download model weights into the image at build time.
# HF_TOKEN is passed as a Docker build secret (never written to any layer):
#   docker build --secret id=hf_token,env=HF_TOKEN ...
# or via docker/build-push-action with secrets: "hf_token=${{ secrets.HF_TOKEN }}"
RUN --mount=type=secret,id=hf_token,required=true \
    hf download \
        --token "$(cat /run/secrets/hf_token)" \
        meta-llama/Llama-3.1-8B-Instruct \
        --local-dir /models/Llama-3.1-8B-Instruct

# ---------------------------------------------------------------------------
# RunPod Serverless handler
# The vllm/vllm-openai image serves an OpenAI-compatible API on port 8000.
# RunPod Serverless wraps this via its OpenAI-compatible proxy, so no custom
# handler code is needed — just point the Serverless endpoint at this image
# and set the template's container command to start vllm.
# ---------------------------------------------------------------------------

ENV MODEL=/models/Llama-3.1-8B-Instruct
ENV GPU_UTIL=0.9
ENV MAX_MODEL_LEN=8192
ENV HOST=0.0.0.0
ENV PORT=8000

EXPOSE 8000

ENTRYPOINT ["sh", "-c", \
    "exec vllm serve \"${MODEL}\" \
        --gpu-memory-utilization \"${GPU_UTIL}\" \
        --max-model-len \"${MAX_MODEL_LEN}\" \
        --host \"${HOST}\" \
        --port \"${PORT}\""]
CMD []
